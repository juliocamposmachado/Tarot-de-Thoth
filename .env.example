# Claude API (server-side only; never use VITE_ for these values)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_WORKSPACE_ID=your_workspace_id
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2026-10-21

# Mercado Pago API Credentials
VITE_MP_PUBLIC_KEY=your_public_key
VITE_MP_ACCESS_TOKEN=your_access_token
VITE_MP_CLIENT_ID=your_client_id
VITE_MP_CLIENT_SECRET=your_client_secret

# General App Settings
VITE_APP_MODE=development
VITE_ENABLE_MOCKS=true
