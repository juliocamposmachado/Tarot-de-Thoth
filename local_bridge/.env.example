# Port for the local bridge server (default: 5317)
BRIDGE_PORT=5317

# ChatGPT conversation URL to automate
CHATGPT_CONVERSATION_URL=https://chatgpt.com/c/6acad485-8b30-83e9-81e3-8ee2b80196dd

# Allowed origins for CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=https://tarot-de-thoth.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Browser profile directory (persistent context for session reuse)
BROWSER_PROFILE_DIR=.browser-profile

# Timeout for ChatGPT response generation in seconds (default: 120)
GENERATION_TIMEOUT=120

# Polling interval for response detection in seconds (default: 2)
POLL_INTERVAL=2

# Run browser in headless mode (true/false)
HEADLESS=false
